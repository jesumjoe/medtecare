# ============================================================
# Squad B — The Logic Engine: Environment Configuration
# ============================================================

# LLM Reasoning Provider Configuration
# Supported providers: "openai", "groq", "fallback" (local deterministic rule-based)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI API Key (Optional — for live LLM diagnostic reasoning synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional — for fast live LLM reasoning via Llama-3)
GROQ_API_KEY=your_groq_api_key_here

# Cohere API Key (Optional — for Cohere rerank-english-v3.0)
# NOTE: If COHERE_API_KEY is not provided, the system automatically uses
# Reciprocal Rank Fusion (RRF) with BGE-small-en-v1.5 + Okapi BM25 completely locally for FREE!
COHERE_API_KEY=your_cohere_api_key_here

# Knowledge Base & Dataset Paths
MEDICAL_DEVICE_DATASET_PATH=DATA/medical_device_ml_dataset.csv
KNOWLEDGE_BASE_DOCS_DIR=logic/knowledge_base/documents

# Embeddings & RAG Configuration
# Default BGE embedding model: BAAI/bge-small-en-v1.5
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5
RRF_K_CONSTANT=60
