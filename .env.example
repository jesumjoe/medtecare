# ============================================================
# MedTeCare / SentinelOps — Environment Configuration Template
# ============================================================

# LLM Reasoning Provider Configuration
# Supported values: "openai", "groq", "fallback" (local zero-cost deterministic reasoning)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI API Key (Optional — for live LLM diagnostic reasoning synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional — for ultra-fast Llama-3 inference)
GROQ_API_KEY=your_groq_api_key_here

# Cohere API Key (Optional — for Cohere rerank-english-v3.0)
# NOTE: Cohere is 100% optional. If omitted, the RAG engine automatically runs
# Reciprocal Rank Fusion (RRF, k=60) with local BGE-small-en-v1.5 + Okapi BM25 completely FREE.
COHERE_API_KEY=your_cohere_api_key_here

# Knowledge Base & Dataset Paths
MEDICAL_DEVICE_DATASET_PATH=DATA/medical_device_ml_dataset.csv
KNOWLEDGE_BASE_DOCS_DIR=logic/knowledge_base/documents

# Embeddings & RAG Configuration
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5
RRF_K_CONSTANT=60
